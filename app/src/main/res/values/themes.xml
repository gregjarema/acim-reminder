<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Uses the built-in Material light theme with a dark action bar so we
         don't need to bundle the Material Components library. -->
    <!-- NoActionBar: no top app-bar/header; content runs under the status bar
         and is padded clear of it in code. -->
    <style name="Theme.AcimReminder" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:colorBackground">#F4F1EC</item>
    </style>
</resources>
