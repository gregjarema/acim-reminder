<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lesson 99"
            android:textSize="30sp"
            android:textColor="#1A1A1A"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Salvation is my only function here."
            android:textSize="20sp"
            android:textStyle="italic"
            android:textColor="#7A6646"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/btnVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="▶  Watch today's lesson video"
            android:textSize="15sp"
            android:textColor="#7A6646"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnBegin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Begin 5-minute meditation"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="#E9E2D4" />

        <TextView
            android:id="@+id/tvLessonHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE LESSON"
            android:textSize="12sp"
            android:letterSpacing="0.16"
            android:textColor="#A08A63" />

        <TextView
            android:id="@+id/tvBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="17sp"
            android:lineSpacingMultiplier="1.5"
            android:textColor="#1E1E1E"
            android:fontFamily="serif" />

    </LinearLayout>
</ScrollView>
