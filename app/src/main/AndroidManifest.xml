<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Show notifications (reminders + meditation countdown). Runtime-granted on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Fire alarms at an exact minute even in Doze. USE_EXACT_ALARM is the
         "alarm clock app" permission: it is granted automatically at install,
         so there's nothing for you to toggle. Holding it also lets the end
         bell play while the screen is off (Android 17 background-audio rule). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Re-arm today's remaining reminders after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Run the meditation as a foreground service so the end bell fires reliably. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Keep the CPU awake during the 5 minutes so playback isn't paused. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Vibrate on reminder notifications. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Ask the OS to stop battery-optimising this app so it isn't killed. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Play today's lesson video inline, right in the app, instead of a browser. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Install a newer build over this one. Android still shows its own
         installer confirmation; nothing here can install silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AcimReminder">

        <!-- configChanges: a rotation is handled in place instead of recreating
             the activity, so the playing video (and its WebView) survives it
             instead of collapsing back to the "Watch video" link. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run permissions walkthrough. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- Today's lesson as a live wallpaper. BIND_WALLPAPER means only the
             system can bind to it, which Android requires for wallpapers. -->
        <service
            android:name=".LessonWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/lesson_wallpaper" />
        </service>

        <!-- The meditation timer + bells. mediaPlayback type = allowed to make
             sound in the background on Android 17. -->
        <service
            android:name=".MeditationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps Marianne's video playing when you leave the screen, and hosts
             the MediaSession that headphone buttons and the lock screen talk to. -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Play/Pause/Stop on the playback notification. -->
        <receiver
            android:name=".PlaybackControlReceiver"
            android:exported="false" />

        <!-- Receives each scheduled reminder alarm and posts the notification. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- Fires the "Begin" action from a reminder notification. -->
        <receiver
            android:name=".BeginReceiver"
            android:exported="false" />

        <!-- Fires the end bell at the exact end-of-meditation minute. -->
        <receiver
            android:name=".EndBellReceiver"
            android:exported="false" />

        <!-- Hands the downloaded APK to the package installer. A file:// uri
             is rejected, so it has to go through a content provider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- The daily check for a newer build. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <!-- Re-arms alarms after the phone reboots. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
