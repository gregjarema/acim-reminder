# Build outputs
.gradle/
build/
app/build/
*/build/

# Local SDK path (each machine sets its own; CI uses ANDROID_HOME)
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Keep the Gradle wrapper jar tracked (do NOT ignore it):
!gradle/wrapper/gradle-wrapper.jar

# Raw lesson emails (intermediate; lessons.json is the committed output)
emails/

# Python cache
__pycache__/

# The signing keystore. CI writes it from a secret; it must never be committed.
app/signing.jks

# Scratch files the email converter writes while scoring a candidate.
tools/.score_tmp/
